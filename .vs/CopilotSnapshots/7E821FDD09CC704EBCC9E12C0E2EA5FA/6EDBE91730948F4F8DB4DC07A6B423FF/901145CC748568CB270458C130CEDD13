<Project Sdk="Microsoft.NET.Sdk">
  
  <ItemGroup>
    <ProjectReference Include="..\regulacao.Core\regulacao.core.csproj" />
    <ProjectReference Include="..\UI\UI.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>listar_exames</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>resources\listar-exames.ico</ApplicationIcon>
    <NoWin32Manifest>true</NoWin32Manifest>
    <PublishSingleFile>true</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- Remover entrada padrão e re-incluir com LogicalName único para evitar colisão de nomes de recursos -->
    <EmbeddedResource Include="FormPrincipal.Components.resx">
      <ManifestResourceName>$(RootNamespace).FormPrincipal.Components</ManifestResourceName>
      <LogicalName>$(RootNamespace).FormPrincipal.Components.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="FormPrincipal.Events.resx">
      <ManifestResourceName>$(RootNamespace).FormPrincipal.Events</ManifestResourceName>
      <LogicalName>$(RootNamespace).FormPrincipal.Events.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="FormPrincipal.resx">
      <LogicalName>$(RootNamespace).FormPrincipal.resources</LogicalName>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>FormPrincipal.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="helpers\AppResources.resx">
      <LogicalName>$(RootNamespace).helpers.AppResources.resources</LogicalName>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>AppResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="FormPrincipal.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FormPrincipal.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="KeepPlaywrightAssemblyOutsideSingleFile" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'Microsoft.Playwright.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  
</Project>
