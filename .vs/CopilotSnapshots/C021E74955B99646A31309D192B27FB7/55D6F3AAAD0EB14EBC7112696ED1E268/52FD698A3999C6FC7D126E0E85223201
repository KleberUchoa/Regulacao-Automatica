using System.Resources;
namespace listar_exames.helpers;

public static class AppResources
{
    private static readonly ResourceManager rm = System.Resources.ResourceManager.CreateFileBasedResourceManager("listar_exames.helpers.AppResources", AppDomain.CurrentDomain.BaseDirectory, null);
    public static Image Save => GetImage("save.png");
    public static Image Edit => GetImage("edit.png");
    public static Image Check => GetImage("check.png");
    public static Image Cross => GetImage("cross.png");
    public static Image Config => GetImage("config.png");
    public static Image Plus => GetImage("plus.png");
    public static Image Minus => GetImage("minus.png");
    public static Image Play => GetImage("play.png");
    public static Image Return => GetImage("return.png");
    public static Icon AppIcon => GetIcon("listar-exames.ico");
    private static Image GetImage(string name)
    {
        var obj = rm.GetObject(name) ?? throw new Exception($"Recurso não encontrado: {name}");
        return obj as Image ?? throw new InvalidOperationException("Recurso não é uma imagem");
    }
    private static Icon GetIcon(string name)
    {
        var obj = rm.GetObject(name) ?? throw new Exception($"Recurso não encontrado: {name}");
        return obj as Icon ?? throw new InvalidOperationException("Recurso não é um ícone");
    }
}