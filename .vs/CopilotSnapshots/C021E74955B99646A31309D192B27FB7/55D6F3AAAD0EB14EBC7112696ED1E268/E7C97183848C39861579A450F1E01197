using System.Resources;
using System.Reflection;
namespace listar_exames.helpers;

public static class AppResources
{
    // Usa o ResourceManager para o arquivo de recursos principal (FormPrincipal.resx) embutido no assembly
    private static readonly ResourceManager rm = new ResourceManager("listar_exames.FormPrincipal", Assembly.GetExecutingAssembly());
    public static Image Save => GetImage("save");
    public static Image Edit => GetImage("edit");
    public static Image Check => GetImage("check");
    public static Image Cross => GetImage("cross");
    public static Image Config => GetImage("config");
    public static Image Plus => GetImage("plus");
    public static Image Minus => GetImage("minus");
    public static Image Play => GetImage("play");
    public static Image Return => GetImage("return");
    public static Icon AppIcon => GetIcon("app");
    private static Image GetImage(string name)
    {
        var obj = rm.GetObject(name) ?? throw new Exception($"Recurso não encontrado: {name}");
        return obj as Image ?? throw new InvalidOperationException("Recurso não é uma imagem");
    }
    private static Icon GetIcon(string name)
    {
        var obj = rm.GetObject(name) ?? throw new Exception($"Recurso não encontrado: {name}");
        return obj as Icon ?? throw new InvalidOperationException("Recurso não é um ícone");
    }
}