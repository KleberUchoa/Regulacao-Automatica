    private async void BtnEnviarParaRegulacao_Click(object sender, EventArgs e)
    {
        if (atendimentos.Count == 0)
            return;

        Enabled = false;
        SalvarListaDeAtendimento();
        try
        {
            //var login = new Padroes("", "helenasolrac@icloud.com", "12345678");
            var regulacao = new RegulacaoService();
            await regulacao.ExecutarAsync(padroesCarregados, atendimentos.ToList(), Bounds);
